{
  "name": "aws-migration-plugins",
  "interface": {
    "displayName": "AWS Migration Plugins (DEPRECATED — moved to aws/agent-toolkit-for-aws)"
  },
  "plugins": [
    {
      "name": "migration-to-aws",
      "source": {
        "source": "local",
        "path": "./migration-to-aws"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "ai-to-aws",
      "source": {
        "source": "local",
        "path": "./ai-to-aws"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    }
  ]
}
