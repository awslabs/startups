{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/telemetry/emit.mjs\" --reconcile",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/telemetry/emit.mjs\" --reconcile",
        "timeout": 30
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/telemetry/emit.mjs\" --session-end",
        "timeout": 10
      }
    ]
  }
}
