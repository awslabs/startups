{
  "description": "Ambient startup context — shapes all responses with a startup lens",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cat ${CLAUDE_PLUGIN_ROOT}/scripts/startup-context.txt",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
