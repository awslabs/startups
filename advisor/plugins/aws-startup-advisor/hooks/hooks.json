{
  "description": "Ambient startup context — shapes all responses with a startup lens. Telemetry hooks are consent-gated and read only the migration skills' own state files; attribution comes from the owning_skill key each run declares on disk, so no per-skill arguments are needed.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cat ${CLAUDE_PLUGIN_ROOT}/scripts/startup-context.txt",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry/emit.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry/emit.mjs\" --reconcile",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry/emit.mjs\" --session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
