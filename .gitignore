# Dependencies
node_modules/
.venv/

# Build outputs
dist/
build/
__pycache__/

# Tool caches
.dprint/
.ruff_cache/
.mise/
.pytest_cache/

# Temporary files
.tmp/
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local

# npm config (may contain registry auth tokens; never commit)
.npmrc

# Claude
.claude/settings.local.json

# Migration artifacts (generated at runtime by plugins)
.migration/

# Sensitive keys. Broad on purpose: a GitHub App private key converted to
# PKCS#8 usually lands under a different name than the downloaded file, so
# matching only *private-key.pem leaves the converted copy unignored.
*.pem
*.key
*.p8
*.p12
*.pfx
